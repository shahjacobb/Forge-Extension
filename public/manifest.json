{
  "manifest_version": 3,
  "name": "Miqat",
  "version": "0.3.0",
  "description": "A focus timer for Chrome. Deep-work sessions, short breaks, and a long break after four rounds. Optional account sync across profiles.",
  "permissions": ["storage", "alarms", "notifications", "offscreen"],
  "host_permissions": ["https://tiopzxojmnortiwbgfrx.supabase.co/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": {
    "16": "icon-16.png",
    "32": "icon-32.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  },
  "action": {
    "default_title": "Miqat — focus timer",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon-16.png",
      "32": "icon-32.png",
      "48": "icon-48.png",
      "128": "icon-128.png"
    }
  },
  "options_page": "options.html",
  "commands": {
    "toggle-timer": {
      "suggested_key": {
        "default": "Alt+Shift+P"
      },
      "description": "Start or pause the Miqat focus timer"
    },
    "skip-session": {
      "description": "Skip to the next Miqat session"
    }
  }
}
